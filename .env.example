# The app works in reference/before mode with none of these enabled.
PORT=3000
# Set on your own machine after genuine AgntID runtime bootstrap.
AGNTID_MCP_URL=
AGNTID_AGENT_ID=second-nurse:v1
AGNTID_USER_ID=synthetic-night-float
AGNTID_ACCESS_TOKEN=
ENABLE_LIVE_EXECUTION=false
# Raw HTTP MCP requires a secret bearer token; stdio remains local.
WARD_MCP_TOKEN=
# Optional explicit remote raw-MCP hostname allowlist (comma-separated).
WARD_ALLOWED_HOSTS=
